# Release configuration for compose.release.yml.
#
#   cp .env.release.example .env.release
#   docker compose --env-file .env.release -f compose.release.yml up -d --build
#
# .env.release is gitignored. It is a plain file read by Docker Compose, not a
# secret manager: restrict its permissions (chmod 600) and keep it off shared hosts.
# Changing a value takes effect after `up -d` recreates the affected containers.
#
# compose.release.yml decides which service receives which variable. Provider
# keys reach only the API container. Web receives nothing from this file, and no
# value here is sent to the browser.

# --- Compose interpolation (PostgreSQL credentials and host port) ---------------
# Required. Generate with `openssl rand -hex 32`. Use URL-safe characters only:
# the value is embedded in NEXUS_DATABASE_URL. Do not reuse the development
# password `nexus`. Changing it later does not alter an existing database volume.
POSTGRES_PASSWORD=
POSTGRES_USER=nexus
POSTGRES_DB=nexus
# Web is always bound to 127.0.0.1; only the host port can change.
NEXUS_WEB_PORT=3000
# Tag for the locally built nexus-api and nexus-web images.
NEXUS_VERSION=0.1.0

# --- API runtime (NEXUS_* settings, API container only) -------------------------
# NEXUS_ENVIRONMENT, NEXUS_DATABASE_URL and NEXUS_QDRANT_URL are set by
# compose.release.yml. Without keys the stack starts and research routes return 503.
NEXUS_OPENAI_API_KEY=
NEXUS_TAVILY_API_KEY=
# NEXUS_OPENAI_MODEL=gpt-4o-mini
# NEXUS_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional USD for one Tavily search. Empty leaves search cost unavailable.
NEXUS_TAVILY_USD_PER_SEARCH=

# Required. At least 32 bytes and distinct from POSTGRES_PASSWORD.
# Generate with `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`.
NEXUS_SESSION_PEPPER=

# Tunables. Leave a line commented to keep the API default; an empty value is invalid.
# NEXUS_AI_TIMEOUT_SECONDS=20
# NEXUS_AI_MAX_RETRIES=1
# NEXUS_DISCOVERY_TIMEOUT_SECONDS=90
# NEXUS_READINESS_TIMEOUT_SECONDS=2.0
# NEXUS_PDF_MAX_BYTES=10485760
# NEXUS_PDF_MAX_PAGES=100
# NEXUS_GRAPH_MAX_ITERATIONS=2
# NEXUS_GRAPH_MAX_SEARCH_CALLS=6
# NEXUS_GRAPH_MAX_LLM_CALLS=13
# NEXUS_GRAPH_MAX_WEB_PAGES=5
# NEXUS_GRAPH_MAX_PASSAGES=12
# A proxy in front of Web needs a read timeout above this deadline plus 5 seconds.
# Keep it at 280 or lower if you call /api/v1/research/run through Web (300 s header limit).
# NEXUS_GRAPH_DEADLINE_SECONDS=180
# NEXUS_GRAPH_EXCERPT_CHARS=500
# NEXUS_STREAM_HEARTBEAT_SECONDS=15
# NEXUS_STREAM_MAX_CONCURRENT=2
# NEXUS_STREAM_CANCEL_PERSIST_SECONDS=2.0
# NEXUS_LOG_FORMAT=json

# --- Observability (optional, off by default) -----------------------------------
# With `--profile observability`, use NEXUS_OTEL_ENDPOINT=http://jaeger:4318/v1/traces.
NEXUS_OTEL_ENABLED=false
NEXUS_OTEL_ENDPOINT=
# NEXUS_OTEL_SERVICE_NAME=nexus-research
# NEXUS_OTEL_SAMPLE_RATIO=1.0
