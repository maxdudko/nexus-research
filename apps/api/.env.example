NEXUS_ENVIRONMENT=development
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8000
NEXUS_DATABASE_URL=postgresql+asyncpg://nexus:nexus@127.0.0.1:5432/nexus
NEXUS_QDRANT_URL=http://127.0.0.1:6333
NEXUS_READINESS_TIMEOUT_SECONDS=2.0
# Optional. Empty keys keep the API starting; AI routes return 503.
NEXUS_OPENAI_API_KEY=
NEXUS_OPENAI_MODEL=gpt-4o-mini
NEXUS_TAVILY_API_KEY=
NEXUS_AI_TIMEOUT_SECONDS=20
NEXUS_AI_MAX_RETRIES=1
NEXUS_DISCOVERY_TIMEOUT_SECONDS=90
NEXUS_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
NEXUS_RAG_COLLECTION=nexus_evidence_v1
NEXUS_RAG_VECTOR_SIZE=1536
NEXUS_EMBEDDING_TIMEOUT_SECONDS=20
NEXUS_EMBEDDING_BATCH_SIZE=64
NEXUS_PDF_MAX_BYTES=10485760
NEXUS_PDF_MAX_PAGES=100
NEXUS_WEB_MAX_BYTES=2097152
NEXUS_WEB_MAX_REDIRECTS=3
NEXUS_CHUNK_TOKENS=800
NEXUS_CHUNK_OVERLAP_TOKENS=120
NEXUS_MAX_CHUNKS=200
NEXUS_EXTRACTED_TEXT_MAX_CHARS=1000000
NEXUS_INGESTION_TIMEOUT_SECONDS=60
NEXUS_WEB_TIMEOUT_SECONDS=10
# Phase 4 graph budgets. One discovery round can spend 3 searches and 4 model calls.
NEXUS_GRAPH_MAX_ITERATIONS=2
NEXUS_GRAPH_MAX_SEARCH_CALLS=6
NEXUS_GRAPH_MAX_LLM_CALLS=13
NEXUS_GRAPH_MAX_WEB_PAGES=5
NEXUS_GRAPH_MAX_PASSAGES=12
NEXUS_GRAPH_DEADLINE_SECONDS=180
NEXUS_GRAPH_EXCERPT_CHARS=500
# Checkpoint tables are created by `uv run python -m nexus.research.checkpoint`.
# Alembic does not own them, and nothing deletes old threads.
# A proxy read timeout must sit above the graph deadline plus 5 seconds (above 185; 200 is safe).
# Observability. Tracing stays off unless an endpoint is set explicitly.
# Start the local collector with `docker compose --profile observability up -d jaeger`.
# The endpoint is the OTLP HTTP traces URL, for example http://127.0.0.1:4318/v1/traces.
NEXUS_OTEL_ENABLED=false
NEXUS_OTEL_ENDPOINT=
NEXUS_OTEL_SERVICE_NAME=nexus-research
NEXUS_OTEL_SAMPLE_RATIO=1.0
NEXUS_LOG_FORMAT=json
# Optional USD for one Tavily search. Empty leaves search cost unavailable.
NEXUS_TAVILY_USD_PER_SEARCH=
# Opt-in smoke tests. Default pytest does not run them.
# NEXUS_RUN_LIVE_AI=1 embeds one query with OpenAI.
# NEXUS_RUN_LIVE_WEB=1 fetches NEXUS_LIVE_WEB_URL through the public-page client.
