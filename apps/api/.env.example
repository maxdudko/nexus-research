NEXUS_ENVIRONMENT=development
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8000
NEXUS_DATABASE_URL=postgresql+asyncpg://nexus:nexus@127.0.0.1:5432/nexus
NEXUS_QDRANT_URL=http://127.0.0.1:6333
NEXUS_READINESS_TIMEOUT_SECONDS=2.0
# Optional. Empty keys keep the API starting; AI routes return 503.
NEXUS_OPENAI_API_KEY=
NEXUS_OPENAI_MODEL=gpt-4o-mini
NEXUS_TAVILY_API_KEY=
NEXUS_AI_TIMEOUT_SECONDS=20
NEXUS_AI_MAX_RETRIES=1
NEXUS_DISCOVERY_TIMEOUT_SECONDS=90
NEXUS_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
NEXUS_RAG_COLLECTION=nexus_evidence_v1
NEXUS_RAG_VECTOR_SIZE=1536
NEXUS_EMBEDDING_TIMEOUT_SECONDS=20
NEXUS_EMBEDDING_BATCH_SIZE=64
